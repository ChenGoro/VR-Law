    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SDF_RoundedRect (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1523.0001220703125,
            "y": 879.0000610351563,
            "width": 259.0,
            "height": 190.00006103515626
        }
    },
    "m_Slots": [
        {
            "m_Id": "898fb6e34881497a94258f8c9a2aed14"
        },
        {
            "m_Id": "0dd37fcee30d4a2e8f9f4e351fbd45dd"
        },
        {
            "m_Id": "eb68b872b3204139ab80198379c2e78f"
        },
        {
            "m_Id": "4a07e499e7ad424590eb458653ce674c"
        },
        {
            "m_Id": "cddca0b0f6f2453db5788b2848e0f97f"
        },
        {
            "m_Id": "14f3fcaf1eda447c8a1674ff46b82a27"
        },
        {
            "m_Id": "6256cd0b47194962818c84127545adad"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "SDF_RoundedRect",
    "m_FunctionSource": "6e745721e1e8a1d41bb846d672130079",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void SDF_RoundedRect_float(float2 p, float2 halfSize, float r, float feather, float border,\r\n                           out float fillA, out float borderA)\r\n{\r\n    // ensure outs are initialized for all code paths\r\n    fillA = 0.0;\r\n    borderA = 0.0;\r\n\r\n    r = min(r, min(halfSize.x, halfSize.y));\r\n    float2 q = abs(p) - (halfSize - r);\r\n    float d = length(max(q, 0.0)) - r;\r\n\r\n    float aOuter = saturate(0.5 - d / max(feather, 1e-6));\r\n    float aInner = saturate(0.5 - (d + border) / max(feather, 1e-6));\r\n\r\n    fillA   = aOuter;\r\n    borderA = saturate(aOuter - aInner);\r\n}\r\n"
}

